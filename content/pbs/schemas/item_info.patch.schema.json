{
    "title": "PBS custom override for item_info.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": { "type": "string", "pattern": "^([a-z0-9]+|\\$[A-Za-z]+)$" },
    "additionalProperties": {
        "anyOf": [
            { "type": "object", "properties": { "price": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] }, "pocket": { "anyOf": [{ "type": "string", "enum": ["misc", "medicine", "pokeballs", "machines", "berries", "mail", "battle", "key"] }, { "type": "null" }] }, "category": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "flags": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] }, "teaches": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }, "additionalProperties": { "anyOf": [{}, { "type": "null" }] } },
            { "type": "null" }
        ]
    },
    "properties": { "$schema": { "type": "string" }, "$comment": { "type": "string" } }
}
