{
    "title": "PBS custom override for abilities.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": { "type": "string", "pattern": "^([a-z0-9]+|\\$[A-Za-z]+)$" },
    "additionalProperties": {
        "anyOf": [
            { "type": "object", "properties": { "num": { "anyOf": [{ "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "null" }] }, "name": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }, "rating": { "anyOf": [{ "type": "number", "minimum": -1, "maximum": 5 }, { "type": "null" }] }, "flags": { "anyOf": [{ "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": { "anyOf": [{ "type": "number", "const": 1 }, { "type": "null" }] } }, { "type": "null" }] }, "gen": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 99 }, { "type": "null" }] }, "isNonstandard": { "anyOf": [{ "anyOf": [{ "type": "string", "enum": ["Past", "Future", "Unobtainable", "CAP", "LGPE", "Custom", "Gigantamax", "Thing"] }, { "type": "null" }] }, { "type": "null" }] } }, "additionalProperties": { "anyOf": [{}, { "type": "null" }] } },
            { "type": "null" }
        ]
    },
    "properties": { "$schema": { "type": "string" }, "$comment": { "type": "string" } }
}
