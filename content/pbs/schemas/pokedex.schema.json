{
    "title": "PBS pokedex.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": { "type": "string", "pattern": "^([a-z0-9]+|\\$[A-Za-z]+)$" },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "num": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "name": { "type": "string", "minLength": 1 },
            "baseSpecies": { "type": "string" },
            "forme": { "type": "string" },
            "baseForme": { "type": "string" },
            "types": { "minItems": 1, "maxItems": 3, "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Za-z?]*$" } },
            "gender": { "type": "string", "enum": ["M", "F", "N"] },
            "genderRatio": { "type": "object", "properties": { "M": { "type": "number", "minimum": 0, "maximum": 1 }, "F": { "type": "number", "minimum": 0, "maximum": 1 } }, "required": ["M", "F"] },
            "baseStats": { "type": "object", "properties": { "hp": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "atk": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "def": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "spa": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "spd": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "spe": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } }, "required": ["hp", "atk", "def", "spa", "spd", "spe"] },
            "abilities": { "type": "object", "properties": { "0": { "type": "string", "minLength": 1 }, "1": { "type": "string", "minLength": 1 }, "H": { "type": "string", "minLength": 1 }, "S": { "type": "string", "minLength": 1 } }, "required": ["0"] },
            "heightm": { "type": "number", "minimum": 0 },
            "weightkg": { "type": "number", "minimum": 0 },
            "color": { "type": "string" },
            "prevo": { "type": "string" },
            "evos": { "type": "array", "items": { "type": "string" } },
            "evoType": { "type": "string", "enum": ["trade", "useItem", "levelMove", "levelExtra", "levelFriendship", "levelHold", "other"] },
            "evoLevel": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "evoItem": { "type": "string" },
            "evoMove": { "type": "string" },
            "evoCondition": { "type": "string" },
            "eggGroups": { "minItems": 1, "type": "array", "items": { "type": "string" } },
            "otherFormes": { "type": "array", "items": { "type": "string" } },
            "cosmeticFormes": { "type": "array", "items": { "type": "string" } },
            "formeOrder": { "type": "array", "items": { "type": "string" } },
            "battleOnly": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
            "requiredItem": { "type": "string" },
            "requiredItems": { "type": "array", "items": { "type": "string" } },
            "requiredMove": { "type": "string" },
            "requiredAbility": { "type": "string" },
            "changesFrom": { "type": "string" },
            "canGigantamax": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string", "enum": ["Mythical", "Restricted Legendary", "Sub-Legendary", "Paradox", "Ultra Beast"] } },
            "gen": { "type": "integer", "minimum": 1, "maximum": 99 },
            "isNonstandard": { "anyOf": [{ "type": "string", "enum": ["Past", "Future", "Unobtainable", "CAP", "LGPE", "Custom", "Gigantamax", "Thing"] }, { "type": "null" }] }
        },
        "required": [
            "num",
            "name",
            "types",
            "baseStats",
            "abilities",
            "heightm",
            "weightkg",
            "color",
            "eggGroups"
        ],
        "additionalProperties": {}
    },
    "properties": { "$schema": { "type": "string" }, "$comment": { "type": "string" } }
}
