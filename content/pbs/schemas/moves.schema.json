{
    "title": "PBS moves.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": { "type": "string", "pattern": "^([a-z0-9]+|\\$[A-Za-z]+)$" },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "num": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "pattern": "^[A-Z][A-Za-z?]*$" },
            "category": { "type": "string", "enum": ["Physical", "Special", "Status"] },
            "basePower": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "accuracy": { "anyOf": [{ "type": "boolean", "const": true }, { "type": "integer", "minimum": 1, "maximum": 100 }] },
            "pp": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "priority": { "type": "integer", "minimum": -7, "maximum": 5 },
            "target": { "type": "string", "enum": ["adjacentAlly", "adjacentAllyOrSelf", "adjacentFoe", "all", "allAdjacent", "allAdjacentFoes", "allies", "allySide", "allyTeam", "any", "foeSide", "normal", "randomNormal", "scripted", "self"] },
            "flags": { "type": "object", "propertyNames": { "type": "string", "enum": ["allyanim", "bypasssub", "bite", "bullet", "cantusetwice", "charge", "contact", "dance", "defrost", "distance", "failcopycat", "failencore", "failinstruct", "failmefirst", "failmimic", "futuremove", "gravity", "heal", "metronome", "mirror", "mustpressure", "noassist", "nonsky", "noparentalbond", "nosketch", "nosleeptalk", "pledgecombo", "powder", "protect", "pulse", "punch", "recharge", "reflectable", "slicing", "snatch", "sound", "wind"] }, "additionalProperties": { "type": "number", "const": 1 } },
            "secondary": { "anyOf": [{ "type": "object", "properties": { "chance": { "type": "number", "minimum": 1, "maximum": 100 }, "status": { "type": "string", "enum": ["brn", "par", "slp", "frz", "psn", "tox"] }, "volatileStatus": { "type": "string" }, "boosts": { "type": "object", "propertyNames": { "type": "string", "enum": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"] }, "additionalProperties": { "type": "integer", "minimum": -6, "maximum": 6 } }, "self": { "type": "object", "properties": { "boosts": { "type": "object", "propertyNames": { "type": "string", "enum": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"] }, "additionalProperties": { "type": "integer", "minimum": -6, "maximum": 6 } }, "volatileStatus": { "type": "string" }, "sideCondition": { "type": "string" }, "chance": { "type": "number" } }, "additionalProperties": {} } }, "additionalProperties": {} }, { "type": "null" }] },
            "secondaries": { "type": "array", "items": { "type": "object", "properties": { "chance": { "type": "number", "minimum": 1, "maximum": 100 }, "status": { "type": "string", "enum": ["brn", "par", "slp", "frz", "psn", "tox"] }, "volatileStatus": { "type": "string" }, "boosts": { "type": "object", "propertyNames": { "type": "string", "enum": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"] }, "additionalProperties": { "type": "integer", "minimum": -6, "maximum": 6 } }, "self": { "type": "object", "properties": { "boosts": { "type": "object", "propertyNames": { "type": "string", "enum": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"] }, "additionalProperties": { "type": "integer", "minimum": -6, "maximum": 6 } }, "volatileStatus": { "type": "string" }, "sideCondition": { "type": "string" }, "chance": { "type": "number" } }, "additionalProperties": {} } }, "additionalProperties": {} } },
            "self": { "type": "object", "properties": { "boosts": { "type": "object", "propertyNames": { "type": "string", "enum": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"] }, "additionalProperties": { "type": "integer", "minimum": -6, "maximum": 6 } }, "volatileStatus": { "type": "string" }, "sideCondition": { "type": "string" }, "chance": { "type": "number" } }, "additionalProperties": {} },
            "status": { "type": "string", "enum": ["brn", "par", "slp", "frz", "psn", "tox"] },
            "volatileStatus": { "type": "string" },
            "boosts": { "type": "object", "propertyNames": { "type": "string", "enum": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"] }, "additionalProperties": { "type": "integer", "minimum": -6, "maximum": 6 } },
            "drain": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }], "items": false, "minItems": 2, "maxItems": 2 },
            "recoil": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }], "items": false, "minItems": 2, "maxItems": 2 },
            "heal": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }], "items": false, "minItems": 2, "maxItems": 2 },
            "critRatio": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "willCrit": { "type": "boolean" },
            "multihit": { "anyOf": [{ "type": "integer", "minimum": 2, "maximum": 9007199254740991 }, { "type": "array", "prefixItems": [{ "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }], "items": false, "minItems": 2, "maxItems": 2 }] },
            "ohko": { "anyOf": [{ "type": "boolean" }, { "type": "string", "pattern": "^[A-Z][A-Za-z?]*$" }] },
            "forceSwitch": { "type": "boolean" },
            "selfSwitch": { "type": ["boolean", "string"] },
            "weather": { "type": "string" },
            "terrain": { "type": "string" },
            "pseudoWeather": { "type": "string" },
            "sideCondition": { "type": "string" },
            "slotCondition": { "type": "string" },
            "isZ": { "anyOf": [{ "type": "string" }, { "type": "boolean", "const": false }] },
            "isMax": { "type": ["boolean", "string"] },
            "gen": { "type": "integer", "minimum": 1, "maximum": 99 },
            "isNonstandard": { "anyOf": [{ "type": "string", "enum": ["Past", "Future", "Unobtainable", "CAP", "LGPE", "Custom", "Gigantamax", "Thing"] }, { "type": "null" }] }
        },
        "required": [
            "num",
            "name",
            "type",
            "category",
            "basePower",
            "accuracy",
            "pp",
            "priority",
            "target",
            "flags"
        ],
        "additionalProperties": {}
    },
    "properties": { "$schema": { "type": "string" }, "$comment": { "type": "string" } }
}
