{
    "title": "PBS species_info.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": { "type": "string", "pattern": "^([a-z0-9]+|\\$[A-Za-z]+)$" },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "catchRate": { "type": "integer", "minimum": 0, "maximum": 255 },
            "baseExp": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
            "evYield": { "type": "object", "propertyNames": { "type": "string", "enum": ["hp", "atk", "def", "spa", "spd", "spe"] }, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 } },
            "growthRate": { "type": "string", "enum": ["slow", "medium", "fast", "medium-slow", "slow-then-very-fast", "fast-then-very-slow"] },
            "hatchCycles": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
            "baseFriendship": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "type": "null" }] },
            "hasGenderDifferences": { "type": "boolean" },
            "isBaby": { "type": "boolean" },
            "isLegendary": { "type": "boolean" },
            "isMythical": { "type": "boolean" },
            "shape": { "type": ["string", "null"] },
            "habitat": { "type": ["string", "null"] },
            "formsSwitchable": { "type": "boolean" },
            "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "evolutions": { "type": "array", "items": { "type": "object", "properties": { "into": { "type": "string" }, "trigger": { "type": "string" }, "minLevel": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "item": { "type": "string" }, "heldItem": { "type": "string" }, "gender": { "type": "string", "enum": ["M", "F"] }, "location": { "type": "string" }, "timeOfDay": { "type": "string", "enum": ["day", "night", "dusk", "full-moon"] }, "knownMove": { "type": "string" }, "knownMoveType": { "type": "string" }, "minHappiness": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "minBeauty": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "minAffection": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "relativePhysicalStats": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "partySpecies": { "type": "string" }, "partyType": { "type": "string" }, "tradeSpecies": { "type": "string" }, "needsOverworldRain": { "type": "boolean" }, "turnUpsideDown": { "type": "boolean" }, "usedMove": { "type": "string" }, "minMoveCount": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "minSteps": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, "minDamageTaken": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 } }, "required": ["into", "trigger"], "additionalProperties": {} } }
        },
        "required": [
            "catchRate",
            "baseExp",
            "evYield",
            "growthRate",
            "hatchCycles",
            "baseFriendship",
            "hasGenderDifferences",
            "isBaby",
            "isLegendary",
            "isMythical"
        ],
        "additionalProperties": {}
    },
    "properties": { "$schema": { "type": "string" }, "$comment": { "type": "string" } }
}
