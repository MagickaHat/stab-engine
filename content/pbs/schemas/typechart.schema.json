{
    "title": "PBS typechart.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": { "type": "string", "pattern": "^([a-z0-9]+|\\$[A-Za-z]+)$" },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "name": { "type": "string", "pattern": "^[A-Z][A-Za-z?]*$" },
            "damageTaken": { "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": { "anyOf": [{ "type": "number", "const": 0 }, { "type": "number", "const": 1 }, { "type": "number", "const": 2 }, { "type": "number", "const": 3 }] } },
            "HPivs": { "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": { "type": "number" } },
            "HPdvs": { "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": { "type": "number" } },
            "isNonstandard": { "anyOf": [{ "type": "string", "enum": ["Past", "Future", "Unobtainable", "CAP", "LGPE", "Custom", "Gigantamax", "Thing"] }, { "type": "null" }] }
        },
        "required": ["damageTaken"],
        "additionalProperties": {}
    },
    "properties": { "$schema": { "type": "string" }, "$comment": { "type": "string" } }
}
