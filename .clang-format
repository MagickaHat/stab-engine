# clang-format settings for STAB-engine.
#
# The pre-commit hook (.githooks/pre-commit) formats only the lines a commit
# changes, so untouched code keeps its layout. Run `npm run format -- <files>`
# to format whole files. The settings follow the code's existing style:
# 4-space indents, braces on their own line, operators at the start of
# continued lines.
---
Language: JavaScript
BasedOnStyle: Google
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
BreakBeforeBinaryOperators: NonAssignment
Cpp11BracedListStyle: Block
SpacesInContainerLiterals: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Never
JavaScriptQuotes: Leave
JavaScriptWrapImports: false
SortIncludes: Never
ReflowComments: false
---
Language: Java
BasedOnStyle: Google
IndentWidth: 4
ContinuationIndentWidth: 8
TabWidth: 4
UseTab: Never
ColumnLimit: 120
BreakBeforeBraces: Allman
SortIncludes: Never
---
Language: Json
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 0
