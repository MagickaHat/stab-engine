{
  "name": "template-vite-ts",
  "description": "A Phaser 3 TypeScript template using Vite.",
  "version": "1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-vite-ts.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-vite-ts/issues"
  },
  "homepage": "https://github.com/phaserjs/template-vite-ts#readme",
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "pokeapi:import": "node tools/pokeapi/import.ts",
    "pbs:validate": "node tools/pbs/validate.ts",
    "pbs:compare": "node tools/pbs/compare.ts",
    "pbs:schemas": "node tools/pbs/schemas.ts",
    "assets:import": "node tools/assets/import.ts",
    "events:validate": "node tools/events/validate.ts",
    "events:sync-tiled": "node tools/events/sync-tiled.ts",
    "events:schema": "node tools/events/schema.ts",
    "events:new": "node tools/events/new-script.ts",
    "test": "node --test \"tools/**/*.test.ts\" \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "@pkmn/client": "^0.7.4",
    "@pkmn/data": "^0.10.15",
    "@pkmn/mods": "^0.11.0",
    "@pkmn/protocol": "^0.7.4",
    "@pkmn/sim": "^0.11.0",
    "esbuild": "^0.28.2",
    "inkjs": "^2.4.0",
    "phaser": "4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terser": "^5.39.0",
    "zod": "^4.6.7"
  }
}
